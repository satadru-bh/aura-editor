{
  "name": "aura-installer",
  "version": "1.0.2",
  "description": "Custom Installer for Aura Editor",
  "main": "main.cjs",
  "private": true,
  "author": "Aura Team",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "electronVersion": "35.7.5",
    "compression": "normal",
    "appId": "com.aura.editor.installer",
    "productName": "Aura Installer",
    "directories": {
      "output": "../dist-installer"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "installer.js",
      "logo.png"
    ],
    "win": {
      "icon": "../build/installerIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Aura-Installer.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Aura-Installer.exe"
    }
  }
}
